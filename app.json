{
  "expo": {
    "name": "Recorda",
    "slug": "recorda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Recorda to access your photos.",
          "savePhotosPermission": "Allow Recorda to save images to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-share",
        {
          "android": [
            "com.instagram.android"
          ],
          "ios": [
            "instagram-stories"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
